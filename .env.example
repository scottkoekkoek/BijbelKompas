# Names only. NEVER put real values in git.
#
# apps/web/.env.local (local development): run `pnpm db:start` and use the printed
# API_URL and PUBLISHABLE_KEY (or ANON_KEY) of the LOCAL stack.
# Vercel (production): set the same two names to the production project's values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# GitHub Actions secret (repository settings > Secrets): production connection string,
# session pooler, used ONLY by the backup and restore-drill workflows.
SUPABASE_DB_URL=

# GitHub Actions variable (not secret): the owner's age PUBLIC key (age1...).
BACKUP_AGE_RECIPIENT=

# AI (ADR-012). Leave unset: then there is no AI provider and nothing is sent anywhere.
# "fictief" is a local test provider for development/CI only; it never runs in production.
# AI_PROVIDER=fictief
# Real provider (ADR-016): AI_PROVIDER=claude plus the SECRET ANTHROPIC_API_KEY (Vercel only, never in git).
# AI_MODEL is optional: claude-opus-5-5 (default), claude-sonnet-5-5 or claude-haiku-5-5.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
